# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → "New OAuth App"
# Homepage URL: http://YOUR_VM_IP
# Authorization callback URL: http://YOUR_VM_IP/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret

# ── App URL ───────────────────────────────────────────────────────────────────
# The public URL of your app (used for OAuth redirects and CORS)
FRONTEND_URL=http://YOUR_VM_IP

# ── Initial Admins ────────────────────────────────────────────────────────────
# Comma-separated GitHub usernames that automatically get admin rights on first login
ADMIN_GITHUB_USERNAMES=your_github_username

# ── Local development (skip GitHub OAuth) ─────────────────────────────────────
# Set DEV_MODE=true to enable a one-click login button that bypasses OAuth.
# Never set this in production — the /api/auth/dev-login endpoint is disabled
# when DEV_MODE is false or absent.
# DEV_MODE=true
# DEV_ADMIN_USERNAME=localdev   # username shown in the UI for the dev account

# ── Optional overrides ────────────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:////data/db/pluim.db
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_SIZE_MB=50
# JWT_EXPIRE_HOURS=168
